{
  "cases": [
    {
      "name": "opaque equal tokens overlap and retain independent identities",
      "gate": "3",
      "latch": false,
      "actions": [
        ["press", "0", 1000, -5000, 0],
        ["press", "0", 2000, 9000, 1],
        ["press", "0", 3000, 10000, 2],
        ["advance", "1/2"],
        ["stop", "3/5"]
      ],
      "tokens": ["word ", "word ", "λ"],
      "expected": [
        ["0", "on", 0, 0, "word "],
        ["1/4", "on", 1, 1, "word "],
        ["1/2", "on", 2, 2, "λ"],
        ["3/5", "off", 0, 0, "word "],
        ["3/5", "off", 1, 1, "word "],
        ["3/5", "off", 2, 2, "λ"]
      ]
    },
    {
      "name": "latched text retains released tokens until the next overlapping group",
      "gate": "4/5",
      "latch": true,
      "actions": [
        ["press", "0", 1000, 1000, 0],
        ["press", "0", 2000, 2000, 1],
        ["advance", "0"],
        ["release", "1/8", 1000],
        ["release", "1/8", 2000],
        ["advance", "1/4"],
        ["press", "3/8", 3000, 3000, 2],
        ["advance", "1/2"],
        ["stop", "3/5"]
      ],
      "tokens": ["a", "s", "😀"],
      "expected": [
        ["0", "on", 0, 0, "a"],
        ["1/5", "off", 0, 0, "a"],
        ["1/4", "on", 1, 1, "s"],
        ["9/20", "off", 1, 1, "s"],
        ["1/2", "on", 2, 2, "😀"],
        ["3/5", "off", 2, 2, "😀"]
      ]
    }
  ]
}
