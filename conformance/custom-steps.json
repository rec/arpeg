{
  "cases": [
    {
      "name": "stop cancels pending repeats",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 4}]},
      "actions": [["on", "0", 60, 100], ["advance", "0"], ["stop", "1/16"], ["advance", "1"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/16", "off", 0, 0, 60, 0]]
    },
    {
      "name": "repeats end before equal-time next attacks",
      "bank": "held", "retrigger": "on_empty", "gate": "1",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 2}]},
      "actions": [["on", "0", 60, 100], ["advance", "1/2"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/4", "off", 0, 0, 60, 0], ["1/4", "on", 1, 0, 60, 100], ["1/2", "off", 1, 0, 60, 0], ["1/2", "on", 2, 0, 60, 100]]
    },
    {
      "name": "variable durations ties rests and one selection per repeat group",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [
        {"kind": "hit", "duration": "1/4 beat"},
        {"kind": "tie", "duration": "1/4 beat"},
        {"kind": "rest", "duration": "1/8 beat"},
        {"kind": "hit", "duration": "1/2 beat", "repeats": 3}
      ]},
      "actions": [["on", "0", 60, 100], ["on", "0", 64, 90], ["on", "0", 67, 80], ["advance", "9/8"]],
      "expected": [
        ["0", "on", 0, 0, 60, 100], ["9/20", "off", 0, 0, 60, 0],
        ["5/8", "on", 1, 1, 64, 90], ["91/120", "off", 1, 1, 64, 0],
        ["19/24", "on", 2, 1, 64, 90], ["37/40", "off", 2, 1, 64, 0],
        ["23/24", "on", 3, 1, 64, 90], ["131/120", "off", 3, 1, 64, 0],
        ["9/8", "on", 4, 2, 67, 80]
      ]
    },
    {
      "name": "tie chain crosses cycle and leading tie starts as rest",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [
        {"kind": "tie", "duration": "1/4 beat"},
        {"kind": "hit", "duration": "1/4 beat"}
      ]},
      "actions": [["on", "0", 60, 100], ["advance", "1"]],
      "expected": [["1/4", "on", 0, 0, 60, 100], ["7/10", "off", 0, 0, 60, 0], ["3/4", "on", 1, 0, 60, 100]]
    },
    {
      "name": "consecutive ties sustain through fractional durations",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [
        {"kind": "hit", "duration": "1/4 beat"},
        {"kind": "tie", "duration": "1/8 beat"},
        {"kind": "tie", "duration": "1/3 beat"},
        {"kind": "rest", "duration": "1/4 beat"}
      ]},
      "actions": [["on", "0", 60, 100], ["advance", "3/4"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["77/120", "off", 0, 0, 60, 0]]
    },
    {
      "name": "empty bank cancels future repeats",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 4}]},
      "actions": [["on", "0", 60, 100], ["advance", "0"], ["off", "1/8", 60], ["on", "3/8", 64, 90], ["advance", "1/2"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/10", "off", 0, 0, 60, 0], ["1/2", "on", 1, 1, 64, 90]]
    },
    {
      "name": "clear cancels a repeat group with an active gate",
      "bank": "add", "retrigger": "bank_edit",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 4}]},
      "actions": [["on", "0", 60, 100], ["advance", "0"], ["clear", "1/16"], ["advance", "1"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/16", "off", 0, 0, 60, 0]]
    },
    {
      "name": "bank edits do not change an admitted repeat group",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 2}]},
      "actions": [["on", "0", 60, 100], ["advance", "0"], ["on", "1/8", 64, 90], ["advance", "1/2"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/5", "off", 0, 0, 60, 0], ["1/4", "on", 1, 0, 60, 100], ["9/20", "off", 1, 0, 60, 0], ["1/2", "on", 2, 1, 64, 90]]
    },
    {
      "name": "only the final repeat sustains into ties",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "hit", "duration": "1/2 beat", "repeats": 2}, {"kind": "tie", "duration": "1/4 beat"}, {"kind": "rest", "duration": "1/4 beat"}]},
      "actions": [["on", "0", 60, 100], ["advance", "3/4"]],
      "expected": [["0", "on", 0, 0, 60, 100], ["1/5", "off", 0, 0, 60, 0], ["1/4", "on", 1, 0, 60, 100], ["7/10", "off", 1, 0, 60, 0]]
    },
    {
      "name": "ties without an occurrence stay silent",
      "bank": "held", "retrigger": "on_empty",
      "rhythm": {"kind": "pattern", "steps": [{"kind": "tie", "duration": "1/3 beat"}]},
      "actions": [["on", "0", 60, 100], ["advance", "2"]],
      "expected": []
    }
  ]
}
